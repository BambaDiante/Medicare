/* =========================================
   Style global de l'application
   ========================================= */

QWidget {
    background-color: #F4F7F8;
    color: #1F2A30;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #F4F7F8;
}

/* =========================================
   Barre latérale (menu)
   ========================================= */

QWidget#menu {
    background-color: #0E7C74;
}

QWidget#menu QLabel {
    background-color: transparent;
    color: #FFFFFF;
    font-weight: bold;
}

QWidget#carteAccueil {
    background-color: #FFFFFF;
    border: 1px solid #E1E7E7;
    border-radius: 10px;
    padding: 12px;
}

QWidget#menu QPushButton {
    background-color: transparent;
    color: #E7F3F1;
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 8px;
    font-size: 13px;
}

QWidget#menu QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

QWidget#menu QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.22);
}

/* =========================================
   Titres
   ========================================= */

QLabel {
    color: #1F2A30;
}

/* =========================================
   Boutons standards (formulaires)
   ========================================= */

QPushButton {
    background-color: #0E9B8E;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #0C8A7E;
}

QPushButton:pressed {
    background-color: #0A776D;
}

QPushButton:disabled {
    background-color: #B9C4C3;
}

/* =========================================
   Champs de saisie
   ========================================= */

QLineEdit, QTextEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D8E0E0;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #0E9B8E;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus,
QDateEdit:focus, QSpinBox:focus {
    border: 1px solid #0E9B8E;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* =========================================
   Tableaux
   ========================================= */

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E1E7E7;
    border-radius: 8px;
    gridline-color: #EEF2F2;
}

QHeaderView::section {
    background-color: #0E7C74;
    color: white;
    padding: 6px;
    border: none;
    font-weight: 600;
}

QTableWidget::item:selected {
    background-color: #D6F0EC;
    color: #1F2A30;
}

/* =========================================
   Cases à cocher
   ========================================= */

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #B9C4C3;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #0E9B8E;
    border: 1px solid #0E9B8E;
}

/* =========================================
   Boîtes de dialogue (Login, Consultation...)
   ========================================= */

QDialog {
    background-color: #F4F7F8;
}