/* =========================================
   Style global de l'application
   ========================================= */

QWidget {
    background-color: #F4F7F8;
    color: #1F2A30;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #F4F7F8;
}

/* =========================================
   Barre latérale (menu)
   ========================================= */

QWidget#menu {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(6, 40, 38, 0.80),
        stop: 1 rgba(6, 40, 38, 0.92)
    );
}

QLabel#titreMenu {
    background-color: transparent;
    color: #FFFFFF;
    letter-spacing: 1px;
}

QFrame#separateurMenu {
    background-color: rgba(255, 255, 255, 0.25);
    border: none;
}

QWidget#menu QPushButton {
    background-color: transparent;
    color: #E7F3F1;
    text-align: left;
    padding: 12px 14px;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 8px;
    font-size: 14px;
}

QWidget#menu QPushButton:hover {
    background-color: rgba(14, 155, 142, 0.35);
    border-left: 3px solid #0E9B8E;
}

QWidget#menu QPushButton:pressed {
    background-color: rgba(14, 155, 142, 0.55);
}
/* =========================================
   Titres
   ========================================= */

QLabel {
    color: #1F2A30;
}

/* =========================================
   Boutons standards (formulaires)
   ========================================= */

QPushButton {
    background-color: #0E9B8E;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #0C8A7E;
}

QPushButton:pressed {
    background-color: #0A776D;
}

QPushButton:disabled {
    background-color: #B9C4C3;
}

/* =========================================
   Champs de saisie
   ========================================= */

QLineEdit, QTextEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D8E0E0;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #0E9B8E;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus,
QDateEdit:focus, QSpinBox:focus {
    border: 1px solid #0E9B8E;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* =========================================
   Tableaux
   ========================================= */

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E1E7E7;
    border-radius: 8px;
    gridline-color: #EEF2F2;
}

QHeaderView::section {
    background-color: #0E7C74;
    color: white;
    padding: 6px;
    border: none;
    font-weight: 600;
}

QTableWidget::item:selected {
    background-color: #D6F0EC;
    color: #1F2A30;
}

/* =========================================
   Cases à cocher
   ========================================= */

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #B9C4C3;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #0E9B8E;
    border: 1px solid #0E9B8E;
}

/* =========================================
   Boîtes de dialogue (Login, Consultation...)
   ========================================= */

QDialog {
    background-color: #F4F7F8;
}

/* =========================================
   Page d'accueil
   ========================================= */

QWidget#panneauAccueil {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(6, 40, 38, 0.55),
        stop: 1 rgba(6, 40, 38, 0.85)
    );
}

QLabel#titreAccueil {
    background-color: transparent;
    color: #FFFFFF;
}

QLabel#sousTitreAccueil {
    background-color: transparent;
    color: #CFEAE6;
    font-size: 15px;
}

QFrame#barreAccentAccueil {
    background-color: #0E9B8E;
    border-radius: 2px;
}

QWidget#carteAccueil {
    background-color: #FFFFFF;
    border: 1px solid #E1E7E7;
    border-radius: 14px;
    padding: 10px;
}

QWidget#carteAccueil:hover {
    background-color: #EAF7F5;
    border: 2px solid #0E9B8E;
}

QLabel#iconeCarteAccueil {
    background-color: transparent;
}

QLabel#titreCarteAccueil {
    font-weight: bold;
    font-size: 15px;
    background-color: transparent;
    color: #1F2A30;
}


#titreAccueil {
    color: #0E9B8E;
    font-size: 42px;
    font-weight: bold;
}
/* =========================================
   Barre de défilement (Scrollbar) pour les menus et listes déroulantes
   ========================================= */

QAbstractItemView {
    background-color: #FFFFFF;
    selection-background-color: #D6F0EC;
    selection-color: #1F2A30;
    border: 1px solid #D8E0E0;
    border-radius: 6px;
}

QScrollBar:vertical {
    background: #F4F7F8;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #B9C4C3;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #0E9B8E;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    subcontrol-origin: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
} 